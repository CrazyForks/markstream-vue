{
  "tsrx": {
    "compiler": "octane/compiler"
  },
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "baseUrl": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@markstream-octane/*": ["./*"],
      "stream-markdown-parser": ["../../markdown-parser/src/index.ts"],
      "stream-markdown-parser/*": ["../../markdown-parser/src/*"],
      "markstream-core": ["../../markstream-core/src/index.ts"],
      "markstream-core/*": ["../../markstream-core/src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "noEmitOnError": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noErrorTruncation": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsrx",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsrx",
    "../markdown-parser/src/types/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
